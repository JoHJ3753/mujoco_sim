<mujoco model="two_link_arm">
  <option gravity="0 0 -9.81" timestep="0.01"/>

  <worldbody>
    <geom type="plane" size="5 5 0.1"/>

    <body name="link1" pos="0 0 1">
      <joint name="shoulder_joint" type="hinge" axis="0 1 0"/>
      <geom type="capsule" fromto="0 0 0 0 0 0.5" size="0.04" mass="1"/>

      <body name="link2" pos="0 0 0.5">
        <joint name="elbow_joint" type="hinge" axis="0 1 0"/>
        <geom type="capsule" fromto="0 0 0 0 0 0.4" size="0.035" mass="0.8"/>
      </body>
    </body>
  </worldbody>

  <actuator>
    <motor name="shoulder_motor" joint="shoulder_joint" ctrlrange="-1 1"/>
    <motor name="elbow_motor" joint="elbow_joint" ctrlrange="-1 1"/>
  </actuator>
</mujoco>
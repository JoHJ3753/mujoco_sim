<mujoco model="simple_arm">
  <option gravity="0 0 -9.81" timestep="0.01"/>

  <worldbody>
    <geom type="plane" size="5 5 0.1"/>

    <body name="arm" pos="0 0 1">
      <joint name="arm_joint" type="hinge" axis="0 1 0"/>
      <geom type="capsule" fromto="0 0 0 0 0 0.6" size="0.05" mass="1"/>
    </body>
  </worldbody>

  <actuator>
    <motor name="arm_motor" joint="arm_joint" ctrlrange="-1 1"/>
  </actuator>

  <sensor>
    <jointpos joint="arm_joint"/>
    <jointvel joint="arm_joint"/>
  </sensor>
</mujoco>